# Twilio WhatsApp Configuration
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_secure_verify_token_here

# Database (if using PostgreSQL)
DB_HOST=localhost
DB_NAME=retail_agent_system
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# Redis (optional - for session/OTP store; else PostgreSQL or in-memory)
REDIS_URL=redis://localhost:6379
# or: REDIS_HOST=localhost
#     REDIS_PORT=6379

# Azure OpenAI (optional - for Copilot Studio / Azure AI; else OPENAI_API_KEY)
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-35-turbo

# Environment
ENVIRONMENT=development
